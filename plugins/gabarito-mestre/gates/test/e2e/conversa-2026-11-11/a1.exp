#!/usr/bin/expect -f
# Aceite A1 da GM-14 (T24): UMA célula da matriz (local × tamanho × tela cheia). FORA de `npm test`: abre uma TUI real do Claude Code numa cópia do repo
# em `ba3986f` sob TMPDIR (FORA do checkout real); gasta tokens. Chamado pelo `rodar-a1.mjs --matriz`; não o rode à mão.
#
#   a1.exp <rundir> <repo> <bin> <node> <rodar-a1.mjs> [curta]
#
# Dois modos (T52, emenda 45): a CONVERSA (padrão: as falas de falas.tsv, um snapshot por ponto) e a sessão `curta` (sem falas: abre, responde a pergunta (b) como o dono faria, e, abaixo do
# limiar de colunas da plataforma, digita `/gabarito painel`). Nos dois o `tty.raw` leva marcos (`OSC 1337;gabarito-marco=<nome>`, gravados por `send_log` só no log): `snap-<n>` antes de cada
# snapshot; `inicio`, `b-respondida`, `pedido` e `depois-do-pedido` na sessão curta. O emulador VT do runner ancora a TELA (placement, aviso, caixa) nesses marcos (emenda 49).
#
# Os argumentos do `claude` (cópia do plugin, observador, superpowers de versão FIXA por --plugin-dir, modelo do condutor, debug) vêm de <rundir>/claude.args, um por linha, montados por `argvDoClaude` no `rodar-a1.mjs`:
# só caminhos da cópia sob TMPDIR; nenhum caminho do repositório real chega ao `claude`. Este arquivo não fixa modelo nem caminho de plugin.
# cols/rows vêm de <rundir>/celula.json.
#
# Digita as falas de <rundir>/falas.tsv (colunas: n, rótulo, sha256, texto), uma por vez, esperando o turno acabar e tirando um `snapshot` do estado do produto
# depois de cada ponto de controle. O texto das falas fica SÓ em <rundir>/falas.tsv (ignorado pelo git); sends.log guarda o sha256, nunca o texto.
# A evidência vem do diário, do observador (obs/a1.jsonl: agentes e `placement` das Panes), dos transcripts e dos snapshots, lidos DEPOIS pelo `rodar-a1.mjs`;
# a tela nunca é evidência. Pergunta de permissão é registrada e nunca respondida; o diálogo de ambiente "Allow external CLAUDE.md file imports?" é RECUSADO e registrado (exp.log).
lassign $argv rundir repo bin node runner modo
if {$modo eq ""} { set modo conversa }
set cel [open $rundir/celula.json r]; set celjson [read $cel]; close $cel
regexp {"cols":(\d+)} $celjson -> cols
regexp {"rows":(\d+)} $celjson -> rows
set af [open $rundir/claude.args r]; set claude_args [split [string trimright [read $af] "\n"] "\n"]; close $af
set obs $rundir/obs
# cwd e PWD da célula são a cópia: nenhum caminho do checkout real herdado
set env(PWD) $repo
catch {unset env(OLDPWD)}
set env(TERM) xterm-256color
set env(OBS_DIR) $rundir/obs
set env(PATH) "$bin:$env(PATH)"
set env(GH_FIXTURE) $rundir/gh.json
set env(GABARITO_POUSO_X) 1
set env(CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION) false
set env(CLAUDE_CODE_DISABLE_AUTO_MEMORY) 1
set env(CLAUDE_CODE_FORCE_SESSION_PERSISTENCE) 1
file mkdir $rundir/obs

# escala dos tempos de espera (só os testes offline do runner, com um `claude` de mentira, a baixam; numa célula real é sempre 1)
set esc 1
if {[info exists env(A1_ESCALA_TEMPO)]} { set esc $env(A1_ESCALA_TEMPO) }
proc t {s} { global esc; set v [expr {int($s * $esc)}]; if {$v < 1} { return 1 }; return $v }
proc marco {nome} { send_log "\033\]1337;gabarito-marco=$nome\007" }
proc sends {tag} { global rundir; set f [open $rundir/sends.log a]; puts $f "[clock seconds] $tag"; close $f }
proc nota {txt} { global rundir; set f [open $rundir/exp.log a]; puts $f "[clock seconds] $txt"; close $f }
# diálogo de ambiente (T44, emenda 39): o CLAUDE.md de um diretório ancestral da cópia importa arquivo externo; a cópia NÃO herda instruções do ambiente do dono, então a resposta é SEMPRE "No, disable external imports". MEDIDO na tty.raw da T44: o foco (❯) já nasce em "No", então só Enter recusa (seta para baixo ACEITARIA). O texto sai com cursor-positioning (ESC[nG entre as palavras), por isso o padrão tolera lixo entre elas
set imports_tratado 0
proc recusarImports {} {
  global imports_tratado
  if {$imports_tratado} { return }
  set imports_tratado 1
  nota "DIALOGO-IMPORTS-EXTERNOS recusado"
  sends recusar-imports
  after 800; send "\r"; after 2000
}
proc drenar {s} {
  set s [t $s]
  set fim [expr {[clock seconds] + $s}]
  set timeout 1
  while {[clock seconds] < $fim} {
    expect {
      -re {external.{1,60}imports\?} { recusarImports }
      -re {Do you want to|Allow this|Esc to cancel} { nota "PERGUNTA-DE-PERMISSAO na tela" }
      -re {.+} {}
      timeout {}
      eof { nota "EOF"; return 0 }
    }
  }
  return 1
}
# turno acabou = 8 s seguidos sem saída na tela (teto de 240 s por ponto)
proc ocioso {} {
  set t0 [clock seconds]
  set timeout [t 8]
  while {[clock seconds] - $t0 < [t 240]} {
    expect {
      -re {.+} { exp_continue }
      timeout { return 1 }
      eof { return 0 }
    }
  }
  return 1
}
proc digitar {sha txt} { sends "digitar $sha"; send -- $txt; after 1200; send "\r" }
proc snapshot {n} { global node runner repo rundir; marco snap-$n; catch {exec $node $runner snapshot $repo $rundir $n} err; if {$err ne ""} { nota "snapshot $n: $err"; set f [open $rundir/snapshot-falhou.log a]; puts $f "snapshot $n: $err"; close $f } }
proc sair {status} {
  global rundir
  nota "fim status=$status"
  set f [open $rundir/exp.status w]; puts $f $status; close $f
  sends exit
  send "/exit\r"; after 2500; send "\r"
  set timeout 15
  expect { eof {} timeout { nota "nao saiu; Ctrl-C"; send "\003"; after 500; send "\003" } }
  catch {close}; catch {wait}
  puts "exp done $status"
  exit 0
}

cd $repo
log_user 0
log_file -a $rundir/tty.raw
set stty_init "rows $rows cols $cols"
spawn claude {*}$claude_args
nota "inicio cols=$cols rows=$rows"

set timeout [t 15]
expect {
  -re {Enter.*confirm|trust this folder|Quick.{0,20}safety} { after 500; sends trust; send "\033\[B"; after 400; send "\r"; after 4000 }
  -re {login|Log in|API key} { nota "LOGIN: nao respondo"; set f [open $rundir/exp.status w]; puts $f NAO_PROVADO_LOGIN; close $f; catch {close}; catch {wait}; exit 3 }
  timeout {}
  eof { nota "EOF cedo"; exit 1 }
}
# o TUI só aceita digitação depois de carregar os mods: espera o 1º registro do observador (até 90 s) e mais 6 s
set t0 [clock seconds]
while {[clock seconds] - $t0 < [t 90]} {
  if {[file exists $rundir/obs/a1.jsonl]} { break }
  if {![drenar 2]} { exit 1 }
}
drenar 6
# carga do plugin gabarito-mestre (T44, emenda 39): só o NOSSO plugin conta e ele precisa estar ATIVO (dependência ausente que o desabilita reprova; dependência de OUTRO plugin com o nosso ativo não); a regra mora em `rodar-a1.mjs plugin`
if {[catch {exec $node $runner plugin $rundir/debug.log}]} {
  nota "PLUGIN NAO CARREGOU"
  set f [open $rundir/exp.status w]; puts $f NAO_PROVADO_PLUGIN; close $f
  send "\003"; after 500; send "\003"; catch {close}; catch {wait}; exit 3
}

# invariante da superfície (T49): o observador já viu render da superfície da célula (lateral ⇒ Pane, acima ⇒ AbovePrompt)? Senão a célula nada mediria: para ANTES da 1ª fala
drenar 5
if {[catch {exec $node $runner superficie $rundir}]} {
  nota "SUPERFICIE NAO OBSERVADA: [string trim [exec cat $rundir/abortar.txt]]"
  sair ABORTADO
}

# sessão curta (T52): sem falas do roteiro. Estágios marcados no tty.raw; o que vale (aviso inteiro, Pane colocada) é lido DEPOIS, da tela, pelo `rodar-a1.mjs`
if {$modo eq "curta"} {
  set cu [open $rundir/curta.json r]; set cujson [read $cu]; close $cu
  set pedido [regexp {"pedido":true} $cujson]
  marco inicio
  drenar 10
  # pergunta (b): o runner responde como o dono (resposta fixa, gravada em resposta-b.json); não abriu ⇒ nada a responder (também fica gravado)
  set cmd ""
  catch { set cmd [string trim [exec $node $runner resposta-b $repo $rundir]] }
  if {$cmd ne ""} { digitar resposta-b $cmd; if {![ocioso]} { sair NAO_PROVADO_EOF } }
  # emenda 50: com PAROU aberto a medida espera ele sair; se não sair, evidência vazia (a célula para, sem pedido)
  set parou 1
  set t0 [clock seconds]
  while {[clock seconds] - $t0 < [t 90]} {
    if {![catch {exec $node $runner parou $repo $rundir}]} { set parou 0; break }
    drenar 5
  }
  if {$parou} { nota "PAROU-NAO-SAIU"; sair PAROU_NAO_SAIU }
  marco b-respondida
  drenar 10
  if {$pedido} {
    marco pedido
    digitar pedido-do-dono "/gabarito painel"
    after 1500; send "\r"
    if {![ocioso]} { sair NAO_PROVADO_EOF }
    marco depois-do-pedido
    drenar 8
  }
  sair CONCLUIDO
}

set arq [open $rundir/falas.tsv r]
set linhas [split [read $arq] "\n"]
close $arq
foreach linha $linhas {
  if {$linha eq ""} { continue }
  set campos [split $linha "\t"]
  set n [lindex $campos 0]
  set rotulo [lindex $campos 1]
  set sha [lindex $campos 2]
  set texto [join [lrange $campos 3 end] "\t"]
  digitar $sha $texto
  if {![ocioso]} { sair NAO_PROVADO_EOF }
  # ponto de controle = tudo que não é "—": o estado do produto depois do turno
  if {$rotulo ne "—"} { snapshot $n }
  # invariante violada (snapshot ou runner escreveu abortar.txt): a célula para na hora, sem digitar o resto
  if {[file exists $rundir/abortar.txt]} { nota "ABORTAR: [string trim [exec cat $rundir/abortar.txt]]"; sair ABORTADO }
}
drenar 20
sair CONCLUIDO
