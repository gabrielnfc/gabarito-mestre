#!/usr/bin/env node
// gh falso do aceite da GM-15 (T27): os PRs #7, #8, #17, #22 e o PR final que encerra (#30) como estariam no GitHub (campos de `gh pr list|view --json`),
// com o filtro de `--head`, `--base`, `--state` e `--search "<ID> in:title"`. Só leitura. O #22 é a virada de PRÉ-VERSÃO (alpha.1) e NÃO encerra (emenda 20, r.13p);
// o #30 é a virada final e encerra. GH_SEM_FINAL=1 tira o #30 (a entrega só tem a pré-versão na `main`). GH_MODO=rc1 simula falha de rede.
const argv = process.argv.slice(2);
if (process.env.GH_MODO === 'rc1') { process.stderr.write('falha de rede\n'); process.exit(1); }

const PRS = [
  { number: 7, state: 'MERGED', baseRefName: 'next', headRefName: 'hotfix/GM-7-arquivado', title: 'hotfix(GM-7): 1.1.1 arquivado', mergedAt: '2026-10-18T12:00:00Z' },
  // o diário (events.sessao-1.jsonl) o dá como `aberto`; no GitHub está MERGED e o head é de OUTRA entrega (GM-9)
  { number: 8, state: 'MERGED', baseRefName: 'next', headRefName: 'enabler/GM-9-fundacao', title: 'enabler(GM-9): E1 fundação', mergedAt: '2026-11-03T12:00:00Z' },
  { number: 17, state: 'MERGED', baseRefName: 'next', headRefName: 'enabler/GM-14-clareza', title: 'enabler(GM-14): 2.1.0-alpha.1 clareza para quem usa', mergedAt: '2026-11-14T12:00:00Z' },
  // a virada de pré-versão: não encerra
  { number: 22, state: 'MERGED', baseRefName: 'main', headRefName: 'next', title: 'release(GM-14): 2.1.0-alpha.1 (next → main)', mergedAt: '2026-11-15T12:00:00Z' },
  // a virada final: encerra
  ...(process.env.GH_SEM_FINAL === '1' ? [] : [{ number: 30, state: 'MERGED', baseRefName: 'main', headRefName: 'next', title: 'release(GM-14): 2.1.0 (next → main)', mergedAt: '2026-11-15T13:00:00Z' }]),
];
const flag = (nome) => { const i = argv.findIndex((a) => a === nome || a.startsWith(`${nome}=`)); return i < 0 ? undefined : argv[i].includes('=') ? argv[i].split('=').slice(1).join('=') : argv[i + 1]; };
const campos = (flag('--json') ?? '').split(',').filter(Boolean);
const so = (p) => Object.fromEntries(campos.map((c) => [c, p[c] ?? null]));

if (argv[0] === 'pr' && argv[1] === 'view') {
  const p = PRS.find((x) => String(x.number) === argv[2]);
  if (!p) { process.stderr.write('no pull requests found\n'); process.exit(1); }
  process.stdout.write(JSON.stringify(so(p)));
} else if (argv[0] === 'pr' && argv[1] === 'list') {
  const head = flag('--head'); const base = flag('--base'); const state = (flag('--state') ?? 'open').toLowerCase(); const busca = flag('--search');
  const id = busca ? busca.replace(/ in:title$/, '') : null;
  const lista = PRS.filter((p) => (head === undefined || p.headRefName === head) && (base === undefined || p.baseRefName === base)
    && (state === 'all' || p.state.toLowerCase() === state) && (id === null || p.title.includes(id)));
  process.stdout.write(JSON.stringify(lista.map(so)));
} else if (argv[0] === 'release' && argv[1] === 'list') {
  process.stdout.write(JSON.stringify([{ tagName: 'v2.1.0-alpha.1' }]));
} else { process.stderr.write(`gh falso: ${argv.join(' ')}\n`); process.exit(2); }
